{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixing Pal",
  "version": "0.2.4",
  "identifier": "com.mixingpal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Mixing Pal",
        "width": 380,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": { "updater": { "pubkey": "" } },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "resources": {
      "../remote-script/MixingPal/": "MixingPal/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
